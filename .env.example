# Local app configuration only. Never commit real credentials.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=space_media;Username=postgres;Password=CHANGE_ME
AllowedOrigins__0=http://localhost:4200
# Set a unique random value of at least 32 UTF-8 bytes outside Development.
# Leave empty in local Development to use a random, ephemeral signing key.
Jwt__Key=
Jwt__Issuer=SpaceMedia.Api
Jwt__Audience=SpaceMedia.Admin
Jwt__AccessTokenMinutes=15
# Media is added manually. No YouTube API key or synchronization is used.
Development__SeedDemoContent=false
# Public website origin used for sitemap absolute URLs (not the API origin).
PublicSite__BaseUrl=http://localhost:4200
# Optional. Set both only when you want the app to bootstrap an administrator.
# AdminBootstrap__Email=
# AdminBootstrap__Password=
