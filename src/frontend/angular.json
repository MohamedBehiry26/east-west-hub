{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "east-west-hub-web": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "sm",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/space-media-web",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "css",
            "styles": [
              "src/styles.css"
            ],
            "assets": [
              {
                "glob": "**/*",
                "input": "public/branding",
                "output": "branding"
              },
              {
                "glob": "**/*",
                "input": "src/assets/demo",
                "output": "assets/demo"
              }
            ]
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              },
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public/branding",
                  "output": "branding"
                },
                {
                  "glob": "**/*",
                  "input": "src/assets/demo",
                  "output": "assets/demo"
                },
                {
                  "glob": "east-west-hub-hero-*",
                  "input": "work/hero-preview-assets",
                  "output": "local-hero-preview"
                }
              ]
            },
            "hero-preview": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "outputPath": "../../work/brand-showreel/angular-preview-build",
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public/branding",
                  "output": "branding"
                },
                {
                  "glob": "**/*",
                  "input": "src/assets/demo",
                  "output": "assets/demo"
                },
                {
                  "glob": "east-west-hub-hero-*",
                  "input": "work/hero-preview-assets",
                  "output": "local-hero-preview"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json",
            "host": "127.0.0.1",
            "port": 4330
          },
          "configurations": {
            "production": {
              "buildTarget": "east-west-hub-web:build:production"
            },
            "development": {
              "buildTarget": "east-west-hub-web:build:development"
            },
            "hero-preview": {
              "buildTarget": "east-west-hub-web:build:hero-preview"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "buildTarget": "east-west-hub-web:build:development",
            "runner": "vitest",
            "runnerConfig": "vitest.config.ts",
            "include": [
              "src/**/*.spec.ts"
            ]
          }
        }
      }
    }
  }
}
