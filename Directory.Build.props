<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <DefaultItemExcludesInProjectFolder>$(DefaultItemExcludesInProjectFolder);**/work/**</DefaultItemExcludesInProjectFolder>
  </PropertyGroup>
</Project>
